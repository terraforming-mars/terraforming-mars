# Slack bot credentials -- see SLACK_SETUP.md to obtain.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me

# Target Terraforming Mars server. Defaults to the community-run instance.
# Override only if you self-host TM.
TM_BASE_URL=https://terraforming-mars.herokuapp.com

# Optional "Claude plays" seat. Claude isn't a Slack user, so its player link
# is DMed to whoever runs Claude Code. Slack user id (U...); defaults to the
# host who ran /tm-newgame when unset.
CLAUDE_OPERATOR_SLACK_USER_ID=
# Player name Claude is seated under. Defaults to "Claude".
CLAUDE_PLAYER_NAME=Claude
